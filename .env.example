# Amara Scents --- environment variables
#
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env` or `.env.local`. Only these two variables are exposed to
# the browser, and both must be the publishable/anon key --- never the
# service-role key.

# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---------------------------------------------------------------------------
# These do NOT go in this file. They are set as Supabase Edge Function secrets
# so they never reach the browser:
#
#   npx supabase secrets set \
#     RESEND_API_KEY=re_... \
#     RESEND_FROM_EMAIL="Amara Scents <orders@your-verified-domain.com>"
# ---------------------------------------------------------------------------